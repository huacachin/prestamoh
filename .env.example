APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Factiliza — consulta DNI/RUC/CE/placa (token propio, no commitear)
FACTILIZA_TOKEN=
MIGO_PE_TOKEN=

# Lectura automática del voucher del Anexo 2 (Claude). Sin clave, el módulo
# sigue funcionando a mano. NUNCA commitear la clave real.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-opus-5
# Solo con una clave de usuario (sk-ant-usr-…): ID del workspace (wrkspc_…). Con clave de workspace, vacío.
ANTHROPIC_WORKSPACE_ID=

# Chat de consulta (23/10/2026): botón flotante que responde preguntas sobre clientes y
# créditos con consultas de SOLO LECTURA. Sin clave no aparece. Clave aparte de la del OCR
# para medir su gasto; el panel muestra el costo del mes. NUNCA commitear la clave.
CHAT_API_KEY=
CHAT_MODELO=claude-sonnet-5-5
CHAT_WORKSPACE_ID=
CHAT_TOPE_PREGUNTAS_DIA=300
# Conexión por la que corren las consultas del chat: 'lectura' = usuario MySQL con solo SELECT
# (CREATE USER 'prestamoh_lectura'@'localhost' IDENTIFIED BY '…'; GRANT SELECT ON base.* TO 'prestamoh_lectura'@'localhost';).
# Sin DB_LECTURA_* usa las credenciales normales.
CHAT_CONEXION=lectura
DB_LECTURA_USERNAME=
DB_LECTURA_PASSWORD=

# Copia de impresión de los documentos (rasteriza el PDF con Ghostscript). Binario `gs` en el PATH o ruta completa.
GHOSTSCRIPT_BIN=gs

# Área Legal (11/10/2026): oculto por defecto; true para ver menú, campana, permisos y rutas legal/*
AREA_LEGAL_ACTIVO=false
